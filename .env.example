# Public Sanity identifiers (safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=$NEXT_PUBLIC_SANITY_PROJECT_ID
SANITY_STUDIO_DATASET=$NEXT_PUBLIC_SANITY_DATASET

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Public site URL used by Sanity Presentation/preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
